# Public browser configuration only. Copy to .env.local and use your development project.
# All VITE_ values are embedded in the browser bundle and are visible to users.
VITE_SUPABASE_URL=https://YOUR_PROJECT.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=YOUR_PUBLIC_PUBLISHABLE_OR_ANON_KEY
VITE_SUPABASE_PROJECT_ID=YOUR_PROJECT

# Optional development-only local UI session (ignored by production builds).
VITE_ENABLE_DEV_MOCK_AUTH=false

# Optional public telemetry configuration. Leave empty to omit these integrations.
# Enable only for a project JB has verified belongs to his account.
VITE_ENABLE_POSTHOG=false
VITE_POSTHOG_KEY=
VITE_POSTHOG_HOST=
VITE_SENTRY_DSN=
VITE_SENTRY_TRACES_SAMPLE_RATE=
VITE_ENABLE_SUPABASE_ANALYTICS=false

# NEVER add service-role keys, Stripe secrets, webhook secrets, provider API keys,
# Vault credentials, or database passwords here. Configure them server-side.
